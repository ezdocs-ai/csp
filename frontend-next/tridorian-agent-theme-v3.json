        ]
      },
      "shadows": {
        "xs": "0 1px 2px rgba(0,0,0,0.30)",
        "sm": "0 6px 18px rgba(0,0,0,0.26)",
        "md": "0 16px 42px rgba(0,0,0,0.34)",
        "lg": "0 28px 80px rgba(0,0,0,0.46)",
        "float": "0 38px 100px rgba(0,0,0,0.56)",
        "colored": "0 0 48px rgba(38,208,124,0.17)",
        "focus": "0 0 0 3px rgba(125,227,176,0.28)"
      }
    }
  },
  "components": {
    "button": {
      "base": {
        "height": "44px",
        "paddingInline": "18px",
        "radius": "12px",
        "font": "labels.button",
        "transition": "motion.duration.fast motion.easing.standard"
      },
      "primary": {
        "background": "brand.primary",
        "foreground": "brand.onPrimary",
        "hover": "brand.primaryStrong",
        "shadow": "colored"
      },
      "secondary": {
        "background": "background.surfaceAlt",
        "foreground": "text.primary",
        "border": "border.default",
        "hover": "background.surfaceTint"
      },
      "ghost": {
        "background": "transparent",
        "foreground": "text.secondary",
        "hover": "background.surfaceAlt"
      },
      "danger": {
        "background": "state.error",
        "foreground": "#FFFFFF"
      },
      "iconOnly": {
        "size": "44px",
        "radius": "12px"
      }
    },
    "card": {
      "base": {
        "background": "background.surface",
        "border": "border.subtle",
        "radius": "18px",
        "padding": "24px"
      },
      "interactive": {
        "hoverTransform": "translateY(-2px)",
        "hoverBorder": "brand.primary",
        "hoverShadow": "md"
      },
      "featured": {
        "radius": "28px",
        "padding": "clamp(24px, 4vw, 48px)",
        "background": "effects.gradients.forestDepth",
        "foreground": "text.inverse"
      },
      "glass": {
        "usage": "floating utility panels only",
        "background": "rgba(255,255,255,0.72)",
        "backdropBlur": "18px",
        "border": "rgba(255,255,255,0.48)"
      }
    },
    "input": {
      "base": {
        "height": "44px",
        "radius": "12px",
        "paddingInline": "14px",
        "background": "background.surface",
        "border": "border.default"
      },
      "hover": {
        "border": "border.strong"
      },
      "focus": {
        "border": "brand.primary",
        "ring": "accessibility.focusRing",
        "ringWidth": "3px"
      },
      "invalid": {
        "border": "state.error",
        "message": "state.error"
      }
    },
    "navigation": {
      "sidebar": {
        "width": "264px",
        "background": "background.inverse",
        "foreground": "text.inverse",
        "itemRadius": "10px",
        "activeBackground": "rgba(38,208,124,0.14)",
        "activeForeground": "brand.luminous"
      },
      "topbar": {
        "height": "68px",
        "background": "rgba(244,248,246,0.82)",
        "backdropBlur": "18px",
        "borderBottom": "border.subtle"
      },
      "mobile": {
        "pattern": "bottom navigation for 3–5 primary destinations; drawer for secondary destinations"
      }
    },
    "badge": {
      "height": "24px",
      "paddingInline": "9px",
      "radius": "full",
      "font": "labels.overline",
      "tones": {
        "neutral": "background.surfaceAlt",
        "success": "brand.primary",
        "info": "brand.violet",
        "danger": "brand.coral",
        "warning": "state.warning"
      }
    },
    "table": {
      "header": {
        "height": "44px",
        "background": "background.surfaceAlt",
        "font": "labels.overline",
        "foreground": "text.tertiary"
      },
      "row": {
        "minHeight": "52px",
        "divider": "border.subtle",
        "hover": "background.surfaceTint"
      },
      "rules": [
        "right-align numeric values",
        "use tabular numerals",
        "keep actions in the last column",
        "use sticky headers for long datasets"
      ]
    },
    "dialog": {
      "width": {
        "sm": "420px",
        "md": "560px",
        "lg": "760px"
      },
      "radius": "28px",
      "padding": "28px",
      "shadow": "float",
      "scrim": "background.scrim"
    },
    "toast": {
      "width": "min(420px, calc(100vw - 32px))",
      "radius": "14px",
      "padding": "14px 16px",
      "shadow": "lg",
      "duration": "5s",
      "placement": "top-right desktop, bottom-center mobile"
    },
    "tooltip": {
      "background": "background.inverse",
      "foreground": "text.inverse",
      "radius": "8px",
      "padding": "6px 9px",
      "fontSize": "12px",
      "delay": "450ms"
    }
  },
  "patterns": {
    "dashboard": {
      "shell": "dark sidebar + light workspace",
      "header": "compact, sticky, lightly translucent",
      "cards": "mixed spans in a 12-column bento grid",
      "charts": "flat fills, minimal gridlines, direct labels when possible"
    },
    "aiWorkspace": {
      "shell": "dark focused canvas",
      "promptArea": "large calm surface with subtle mint edge glow",
      "agentStatus": "luminous green for active, violet for thinking/automation",
      "streaming": "animate only the newest content with a short fade/slide"
    },
    "settings": {
      "layout": "narrow reading column with anchored section navigation",
      "dividers": "use whitespace first, subtle borders second"
    },
    "auth": {
      "layout": "split composition: focused form + branded atmospheric panel",
      "mobile": "form first; hide non-essential decorative panel"
    },
    "marketing": {
      "hero": "oversized display type with one gradient or orbital motif",
      "proof": "logos and metrics kept monochrome until hover",
      "cta": "one primary action and one understated secondary action"
    },
    "emptyState": {
      "illustration": "simple geometric linework, no stock illustration",
      "copy": "one sentence explaining the state, one sentence explaining the next action",
      "actions": "maximum two"
    }
  },
  "accessibility": {
    "minimumContrast": {
      "normalText": "4.5:1",
      "largeText": "3:1",
      "uiComponents": "3:1"
    },
    "focus": {
      "selector": ":focus-visible",
      "width": "3px",
      "offset": "2px",
      "style": "solid"
    },
    "touchTarget": "44px minimum",
    "keyboard": "All interactive controls must be reachable and operable by keyboard in logical DOM order.",
    "colorIndependence": "Pair status color with text, icon, shape, or pattern.",
    "motion": "Respect prefers-reduced-motion and avoid parallax on core workflows."
  },
  "implementation": {
    "fontLoading": "Import Space Grotesk, Inter, Readex Pro, and JetBrains Mono at the application root. Use font-display: swap.",
    "themeSwitch": "Set data-theme='light' or data-theme='dark' on the html element and map semantic values to CSS custom properties.",
    "transition": "Apply 190ms transitions to background-color, color, border-color, and box-shadow during theme changes; disable under prefers-reduced-motion.",
    "tokenPolicy": "Components consume semantic aliases only. Raw palette values are allowed only in token definitions, illustrations, and data visualization arrays.",
    "responsivePolicy": "Start with a single-column mobile layout. Introduce split layouts at 768px and full bento composition at 1024px.",
    "iconPolicy": "Use one outline icon family with 1.75–2px strokes, rounded joins, and optical sizes of 16, 20, and 24px.",
    "cssVariablePrefix": "--tri-"
  }
}
